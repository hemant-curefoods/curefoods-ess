{
  "name": "curefoods-ess",
  "version": "1.0.0",
  "private": true,
  "description": "Curefoods Employee Self Service portal — Node.js + PostgreSQL",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "import:employees": "node scripts/import-employees.js",
    "template": "node scripts/make-template.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@googleapis/drive": "^27.1.0",
    "@googleapis/sheets": "^18.1.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  }
}
