# ---------------------------------------------------------------
# Curefoods ESS — copy to .env on the server and fill in.
#   cp .env.example .env && chmod 600 .env
# Never commit .env.
# ---------------------------------------------------------------

# --- web server ---
PORT=3100
# 127.0.0.1 = only reachable through nginx (recommended). Use 0.0.0.0 only if you have no nginx.
HOST=127.0.0.1
# Set to true once the site is served over HTTPS (domain + SSL)
HTTPS=false

# --- PostgreSQL (the portal's own login, see sql/000_setup_db_user.sql) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=your_database_name
PGUSER=ess_app
PGPASSWORD=change-me
# true if the DB requires SSL (not needed for localhost)
PGSSL=false

# --- security ---
# Long random secret mixed into PIN hashes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing it later invalidates every PIN (everyone re-verifies DOB).
PIN_PEPPER=

# Employee Codes, comma separated
HR_HEAD_CODES=
ADMIN_CODES=

# Lockout + sessions
MAX_FAILS=5
LOCK_MINUTES=30
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12

# Where ticket attachments are stored (outside the web root)
UPLOAD_DIR=/var/lib/curefoods-ess/uploads

# --- Google Sheets + Drive (offer letters, NAPS payslips) ---
# Path to the service-account JSON key. Share both sheets and the PDF folders with
# the service account e-mail (Viewer). Leave blank to keep documents switched off.
GOOGLE_APPLICATION_CREDENTIALS=
OFFER_SHEET_ID=
OFFER_SHEET_TAB=Offer Log
# One NAPS Payroll spreadsheet per entity — comma-separated spreadsheet IDs
NAPS_SHEET_IDS=
NAPS_SHEET_TAB=Payroll
SHEETS_CACHE_SECONDS=300
